# Backend only — 실제 값은 커밋하지 않는 backend/.env 에 보관
# AI 연결은 현재 공란: services/intent.py call_llm_recommend, services/reason.py call_llm_translate,
# services/poster_parser.py call_llm_poster. 공급자 확정 후 AI 담당이 구현.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

DATABASE_URL=sqlite:///./data/amp.db
UPLOAD_DIR=./uploads
APP_TIMEZONE=Asia/Seoul
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=true
MAX_POSTER_MB=5

# 설정하면 관리자 API(POST /api/events, /api/posters/parse, /api/translate)에 X-Admin-Key 헤더 필요.
# 비워 두면 DEMO_MODE=true 일 때 loopback(127.0.0.1) 요청만 허용.
ADMIN_API_KEY=

# 고정 테스트 시계 (예: 2026-11-06T03:00:00Z). 비우면 실제 시각.
FIXED_NOW_UTC=
